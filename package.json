{
  "name": "@convokitapp/react-native-ui",
  "version": "0.4.0",
  "description": "Extensible React Native conversation UI for ConvoKit.",
  "license": "MIT",
  "type": "module",
  "source": "./src/index.ts",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "react-native": "./src/index.ts",
  "types": "./lib/typescript/module/index.d.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    }
  },
  "files": ["src", "lib", "README.md"],
  "engines": { "node": ">=22.13.0" },
  "peerDependencies": {
    "@convokitapp/react-native": ">=0.4.0 <0.5.0",
    "react": ">=19.2.0",
    "react-native": ">=0.86.0 <0.88.0"
  },
  "devDependencies": {
    "@convokitapp/react-native": "0.4.0",
    "@types/react": "^19.2.0",
    "react": "^19.2.0",
    "react-native": "^0.87.0",
    "react-native-builder-bob": "^0.40.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  },
  "scripts": {
    "build": "bob build",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [["commonjs", {"esm": true}], ["module", {"esm": true}], ["typescript", {"project": "tsconfig.build.json"}]]
  }
}
